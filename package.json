
{
  "name": "zephyr-toast",
  "version": "1.5.0",
  "description": "A lightweight, customizable, dependency-free JavaScript toast notification library.",
  "type": "module",
  "main": "./dist/zephyr-toast.js",
  "module": "./dist/zephyr-toast.es.js",
  "style": "./dist/zephyr-toast.css",
  "exports": {
    ".": {
      "import": "./dist/zephyr-toast.es.js",
      "default": "./dist/zephyr-toast.js"
    },
    "./style.css": "./dist/zephyr-toast.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode module && vite build --mode browser",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarwaralamini/zephyr-toast.git"
  },
  "keywords": [
    "toast",
    "notification",
    "javascript",
    "vanilla-js",
    "toast-notification",
    "zero-dependency"
  ],
  "author": {
    "name": "Md. Sarwar Alam",
    "url": "https://github.com/sarwaralamini"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sarwaralamini/zephyr-toast/issues"
  },
  "homepage": "https://github.com/sarwaralamini/zephyr-toast#readme",
  "devDependencies": {
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
